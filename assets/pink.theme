{
  "text-color": "#2B2626",
  "background-color": "#FBF1F5",
  "line-number-color": "#b89aa6",
  "line-number-background-color": null,
  "text-styles": {
    "Keyword":       { "text-color": "#B0215E", "bold": true },
    "ControlFlow":   { "text-color": "#B0215E", "bold": true },
    "Function":      { "text-color": "#6B2D8C" },
    "BuiltIn":       { "text-color": "#6B2D8C" },
    "Variable":      { "text-color": "#2B2626" },
    "DataType":      { "text-color": "#8E4A00" },
    "DecVal":        { "text-color": "#B35C00" },
    "Float":         { "text-color": "#B35C00" },
    "BaseN":         { "text-color": "#B35C00" },
    "Constant":      { "text-color": "#B35C00" },
    "String":        { "text-color": "#2E7D32" },
    "Char":          { "text-color": "#2E7D32" },
    "SpecialString": { "text-color": "#2E7D32" },
    "VerbatimString":{ "text-color": "#2E7D32" },
    "Comment":       { "text-color": "#8a7a80", "italic": true },
    "Documentation": { "text-color": "#8a7a80", "italic": true },
    "Operator":      { "text-color": "#7A1E45" },
    "Import":        { "text-color": "#B0215E", "bold": true },
    "Attribute":     { "text-color": "#6B2D8C" },
    "Other":         { "text-color": "#6B2D8C" },
    "Error":         { "text-color": "#C62828", "bold": true },
    "Alert":         { "text-color": "#C62828", "bold": true }
  }
}
